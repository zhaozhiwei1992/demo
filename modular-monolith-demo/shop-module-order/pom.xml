<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.acme</groupId>
        <artifactId>modular-monolith-demo</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>shop-module-order</artifactId>
    <description>业务模块：订单。叶子模块，只依赖 shop-common + 技术 starter，不依赖任何其他业务模块</description>

    <dependencies>
        <dependency>
            <groupId>com.acme</groupId>
            <artifactId>shop-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- @ApplicationModule 注解在 main 源码里（RUNTIME retention），compile 依赖；
             不含 starter 自动配置，运行时惰性；per-biz verify 测试也用它 -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
