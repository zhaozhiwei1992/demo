<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- BOM 必须独立：没有 parent（否则与根 pom import 形成循环），自行声明版本 -->
    <groupId>com.acme</groupId>
    <artifactId>shop-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>shop-dependencies</name>
    <description>全部三方依赖版本管理（BOM），只放版本，不放代码</description>

    <properties>
        <revision>1.0.0</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring Boot 3.3.x 对应 Spring Modulith 1.2/1.3（1.3.4 实测可用） -->
        <spring.boot.version>3.3.5</spring.boot.version>
        <spring-modulith.version>1.3.4</spring-modulith.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 全家桶版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 第 2 层守卫：Spring Modulith（包级模块校验） -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-core</artifactId>
                <version>${spring-modulith.version}</version>
            </dependency>
            <!-- 第 3 层守卫：ArchUnit（分层 + 技术债） -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- 内部构件版本也统一在这里管（与 yudao 的 z-dependencies 一致） -->
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>shop-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>shop-module-order</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>shop-module-payment</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.acme</groupId>
                <artifactId>shop-module-user</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
